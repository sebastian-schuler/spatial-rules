{
    "name": "spatial-rules",
    "version": "0.2.0",
    "description": "High-performance spatial rules/query engine (Rust core, Node/Bun binding)",
    "license": "MIT OR Apache-2.0",
    "author": "Sebastian Schuler",
    "homepage": "https://github.com/sebastian-schuler/spatial-rules#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sebastian-schuler/spatial-rules.git"
    },
    "bugs": {
        "url": "https://github.com/sebastian-schuler/spatial-rules/issues"
    },
    "keywords": [
        "geojson",
        "spatial",
        "gis",
        "rules-engine",
        "query",
        "r-tree",
        "napi"
    ],
    "engines": {
        "node": ">=18"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "type": "module",
    "napi": {
        "name": "spatial-rules",
        "triples": {
            "defaults": false,
            "additional": [
                "x86_64-unknown-linux-gnu",
                "x86_64-unknown-linux-musl",
                "aarch64-unknown-linux-gnu",
                "aarch64-unknown-linux-musl",
                "x86_64-pc-windows-msvc",
                "aarch64-pc-windows-msvc"
            ]
        }
    },
    "files": [
        "dist/",
        "npm/",
        "README.md",
        "LICENSE-MIT",
        "LICENSE-APACHE",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "napi build --platform --release",
        "build:debug": "napi build --platform",
        "artifacts": "napi artifacts",
        "build:ts": "tsc -p tsconfig.build.json",
        "prepack": "node scripts/sync-docs.mjs && npm run build:ts",
        "prepublishOnly": "napi prepublish -t npm",
        "typecheck": "tsc --noEmit",
        "test": "node --experimental-strip-types test/smoke.ts"
    },
    "devDependencies": {
        "@napi-rs/cli": "^2.18.4",
        "@types/node": "^24.0.0",
        "typescript": "^5.9.0"
    },
    "optionalDependencies": {
        "spatial-rules-win32-x64-msvc": "0.2.0",
        "spatial-rules-win32-arm64-msvc": "0.2.0",
        "spatial-rules-linux-x64-gnu": "0.2.0",
        "spatial-rules-linux-x64-musl": "0.2.0",
        "spatial-rules-linux-arm64-gnu": "0.2.0",
        "spatial-rules-linux-arm64-musl": "0.2.0"
    }
}