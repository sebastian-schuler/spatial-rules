{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "plugins": [
        {
            "type": "linked-versions",
            "groupName": "spatial-rules",
            "components": [
                "spatial-rules",
                "spatial-rules-wasm",
                "spatial-rules-python"
            ]
        }
    ],
    "packages": {
        "node": {
            "release-type": "node",
            "package-name": "spatial-rules",
            "include-component-in-tag": false,
            "bump-minor-pre-major": true,
            "changelog-path": "/CHANGELOG.md",
            "extra-files": [
                {
                    "type": "json",
                    "path": "npm/win32-x64-msvc/package.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "npm/win32-arm64-msvc/package.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "npm/linux-x64-gnu/package.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "npm/linux-x64-musl/package.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "npm/linux-arm64-gnu/package.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "npm/linux-arm64-musl/package.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "package.json",
                    "jsonpath": "$.optionalDependencies[\"spatial-rules-win32-x64-msvc\"]"
                },
                {
                    "type": "json",
                    "path": "package.json",
                    "jsonpath": "$.optionalDependencies[\"spatial-rules-win32-arm64-msvc\"]"
                },
                {
                    "type": "json",
                    "path": "package.json",
                    "jsonpath": "$.optionalDependencies[\"spatial-rules-linux-x64-gnu\"]"
                },
                {
                    "type": "json",
                    "path": "package.json",
                    "jsonpath": "$.optionalDependencies[\"spatial-rules-linux-x64-musl\"]"
                },
                {
                    "type": "json",
                    "path": "package.json",
                    "jsonpath": "$.optionalDependencies[\"spatial-rules-linux-arm64-gnu\"]"
                },
                {
                    "type": "json",
                    "path": "package.json",
                    "jsonpath": "$.optionalDependencies[\"spatial-rules-linux-arm64-musl\"]"
                }
            ]
        },
        "wasm": {
            "release-type": "node",
            "package-name": "spatial-rules-wasm",
            "bump-minor-pre-major": true,
            "changelog-path": "CHANGELOG.md"
        },
        "python": {
            "release-type": "python",
            "package-name": "spatial-rules",
            "component": "spatial-rules-python",
            "bump-minor-pre-major": true,
            "changelog-path": "CHANGELOG.md",
            "extra-files": [
                {
                    "type": "toml",
                    "path": "../Cargo.toml",
                    "jsonpath": "$.workspace.package.version"
                }
            ]
        }
    }
}
